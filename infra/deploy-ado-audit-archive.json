{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "US-SOX ITGC: Azure DevOps change-management evidence archive. Creates 4 custom tables in an existing Log Analytics workspace and one DCR (kind=Direct) for the Logs Ingestion API."
  },
  "parameters": {
    "workspaceName": {
      "type": "string",
      "metadata": {
        "description": "Existing Log Analytics workspace name. Must be in this resource group."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Must match the Log Analytics workspace region."
      }
    },
    "dcrName": {
      "type": "string",
      "defaultValue": "dcr-ado-audit",
      "metadata": {
        "description": "Name of the Data Collection Rule created for direct ingestion."
      }
    },
    "interactiveRetentionInDays": {
      "type": "int",
      "defaultValue": 730,
      "minValue": 30,
      "maxValue": 730,
      "metadata": {
        "description": "Interactive (Analytics) retention. Azure hard limit is 730 days."
      }
    },
    "totalRetentionInDays": {
      "type": "int",
      "defaultValue": 1095,
      "minValue": 30,
      "maxValue": 4383,
      "metadata": {
        "description": "Interactive + long-term retention. 1095 = 3 years (US-SOX requirement for this engagement)."
      }
    }
  },
  "variables": {
    "tablePullRequest": "ADO_PullRequest_CL",
    "tablePipelineRun": "ADO_PipelineRun_CL",
    "tableApproval": "ADO_Approval_CL",
    "tableExportAudit": "ADO_ExportAudit_CL",
    "colsPullRequest": [
      {
        "name": "TimeGenerated",
        "type": "dateTime",
        "description": "PR closed date, or creation date when still active."
      },
      {
        "name": "RecordId",
        "type": "string",
        "description": "Stable dedup key: PR-{org}-{projectId}-{repoId}-{pullRequestId}"
      },
      {
        "name": "Organization",
        "type": "string"
      },
      {
        "name": "ProjectName",
        "type": "string"
      },
      {
        "name": "ProjectId",
