      },
      {
        "name": "RejectedCount",
        "type": "int",
        "description": "Reviewers with vote -10 (rejected) or -5 (waiting for author)."
      },
      {
        "name": "IsSelfApproved",
        "type": "boolean",
        "description": "SOD evidence: true when the PR creator is also an approver."
      },
      {
        "name": "ReviewersJson",
        "type": "string",
        "description": "JSON array: displayName / uniqueName / vote / isRequired / isContainer"
      },
      {
        "name": "PolicyEvaluationsJson",
        "type": "string",
